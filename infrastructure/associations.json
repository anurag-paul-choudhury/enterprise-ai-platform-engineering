      "type": "string",
      "defaultValue": "vnet-enterprise-ai"
    },
    "appNsgName": {
      "type": "string",
      "defaultValue": "nsg-app"
    },
    "managementNsgName": {
      "type": "string",
      "defaultValue": "nsg-management"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks/subnets",
      "apiVersion": "2024-05-01",
